{
  "name": "todo-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend --prefix-colors blue,green \"uvicorn todo.api.app:create_app --factory --reload --port 8000\" \"nuxt dev\"",
    "backend": "uvicorn todo.api.app:create_app --factory --reload --port 8000",
    "frontend": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "marked": "^15.0.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "concurrently": "^9.0.0",
    "happy-dom": "^15.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
