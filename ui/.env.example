# Backend API proxy target (dev only).
# Requests to /api/* are forwarded to this URL.
NUXT_API_PROXY_TARGET=http://localhost:8000

# Public base URL for the backend API.
# Leave empty when a reverse-proxy or devProxy handles /api/* routing.
# Set to "http://backend-host:port" for standalone deployments.
NUXT_PUBLIC_API_BASE=
